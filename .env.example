# Copy to .env.local for local overrides.

# Public site URL (Open Graph, OAuth redirect fallback)
NEXT_PUBLIC_SITE_URL=https://papakow.com

# Twitch channel used by the player embed + live check
NEXT_PUBLIC_TWITCH_CHANNEL=papakow

# Optional — enables the "Sign in with Twitch" button (implicit grant on this static export).
# Register an app at https://dev.twitch.tv/console/apps
# Redirect URL must match exactly (include trailing slash if the app uses trailingSlash).
NEXT_PUBLIC_TWITCH_CLIENT_ID=
NEXT_PUBLIC_TWITCH_REDIRECT_URI=https://papakow.com/

# Server-only. Not read by the current static export.
# TODO: use with an auth function that exchanges the OAuth code for a token.
# TWITCH_CLIENT_SECRET=
